227:         yield from builder()
228: 
229: 
230: def write_corpus(path=CORPUS_PATH):
231:     path.parent.mkdir(parents=True, exist_ok=True)
232:     counts = Counter()
233:     with open(path, "w", encoding="utf-8") as f:
234:         for record in build_chunks():
235:             f.write(json.dumps(record, ensure_ascii=False) + "\n")
236:             counts[record["source_id"]] += 1
237:     return counts
